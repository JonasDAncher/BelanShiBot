DISCORD_TOKEN=your-bot-token-here
# Which commands go to which servers is set in commands.toml
# Set to false to skip syncing slash commands on every start
SYNC_COMMANDS=true

# MariaDB (required for /raid commands; leave out to run without them)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=belan_shi
DB_PASSWORD=change-me
DB_NAME=belan_shi

# Fallback time zone for raids until an admin runs /raid setup (IANA name, e.g. Europe/Paris)
DEFAULT_TIMEZONE=UTC

DISCORD_TOKEN=your-bot-token-here
# Guild that receives guild-only commands such as /quiz
TEST_GUILD_ID=489890364090744892
# Set to false to skip syncing slash commands on every start
SYNC_COMMANDS=true

# MariaDB (required for /raid commands; leave out to run without them)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=belan_shi
DB_PASSWORD=change-me
DB_NAME=belan_shi

# Servers that get the /raid commands (comma-separated IDs). Defaults to TEST_GUILD_ID only.
# Set to "all" to make /raid available on every server.
#RAID_GUILD_IDS=489890364090744892

# Fallback time zone for raids until an admin runs /raid setup (IANA name, e.g. Europe/Paris)
DEFAULT_TIMEZONE=UTC
